PDV_EXE_PATH=D:\SAT Sistemas\SAT_HOMOLOGADAS\SATPDV.exe
PDV_USER=
PDV_PASSWORD=
# Opcional: se ausentes, os testes de autorizacao usam PDV_USER/PDV_PASSWORD.
PDV_MANAGER_USER=
PDV_MANAGER_PASSWORD=
PDV_LOGIN_REQUIRED=true
PDV_PRODUCT_CODE=
PDV_INVALID_PRODUCT_CODE=1234
PDV_ALLOW_REAL_RUN=false
PDV_BACKEND=win32
# native preserva o layout fixo 800x600 e centraliza em um monitor;
# fullscreen ocupa o monitor inteiro e pode deixar area vazia.
PDV_WINDOW_MODE=fullscreen
PDV_WINDOW_TITLE_REGEX=SAT\s*-\s*PDV|SATPDV|PDV
PDV_LOGIN_TITLE_REGEX=login|senha|matr[ií]cula|SAT
PDV_START_TIMEOUT=30
PDV_ACTION_TIMEOUT=10
PDV_REPORT_ROOT=reports
PDV_CLOSE_AFTER_TEST=true
